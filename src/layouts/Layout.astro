---
import "../styles/global.css";

const name = "Andres";
const github = "https://github.com/afernandezrios";
const linkedin = "https://www.linkedin.com/in/afernandezrios/";
const email = "andresfdezrios@gmail.com";
const base = import.meta.env.BASE_URL;

const { title = `${name} — Personal Projects` } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="Portfolio of a backend software engineer: experience, projects, and contact."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap"
    />
  </head>

  <body>
    <div class="page">
      <header>
        <a class="brand" href={base}>{name}</a>

        <nav class="nav" aria-label="Main">
          <a href={base + "#about"}>About</a>
          <a href={base + "#experience"}>Experience</a>
          <a href={base + "#projects"}>Projects</a>
          <a href={base + "#interests"}>Interests</a>
          <a href={base + "#contact"}>Contact</a>
          <a class="nav-github" href={github} aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path
                d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"
                fill="currentColor"
              />
            </svg>
          </a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <span>{name}</span>
        <div class="social">
          <a href={github}>GitHub</a>
          <a href={linkedin}>LinkedIn</a>
          <a href={`mailto:${email}`}>Email</a>
          <a href="#">Back to top ↑</a>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  header {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    gap: 20px;
  }

  .brand {
    font-size: 15px;
    font-weight: 750;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--blue);
  }

  .nav {
    display: flex;
    gap: 28px;
    align-items: center;
    font-size: 13px;
    color: #43506b;
  }

  .nav a:hover {
    color: var(--blue);
  }

  .nav-github {
    display: flex;
  }

  footer {
    border-top: 1px solid var(--line);
    padding: 22px 0 30px;
    display: flex;
    justify-content: space-between;
    gap: 15px;
    color: #6b7890;
    font-size: 12px;
  }

  .social {
    display: flex;
    gap: 20px;
    color: #34425d;
  }

  .social a:hover {
    color: var(--blue);
  }

  @media (max-width: 800px) {
    .nav {
      gap: 13px;
      font-size: 12px;
    }
  }

  @media (max-width: 520px) {
    header {
      height: auto;
      padding: 18px 0;
      align-items: flex-start;
      flex-direction: column;
    }

    .nav {
      flex-wrap: wrap;
    }

    footer {
      flex-direction: column;
    }
  }
</style>
