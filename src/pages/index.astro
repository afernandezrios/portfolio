---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const name = "Andres";
const github = "https://github.com/afernandezrios";
const email = "andresfdezrios@gmail.com";
const base = import.meta.env.BASE_URL;

const experience = (await getCollection("experience")).sort((a, b) =>
  b.data.start.localeCompare(a.data.start),
);
const projects = (await getCollection("projects")).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) -
      (b.data.order ?? Number.MAX_SAFE_INTEGER) ||
    a.data.title.localeCompare(b.data.title),
);

const stack = ["Java", "Spring Boot", "AWS", "Go", "Kafka"];

const art: Record<string, string> = {
  ccrun: "terminal",
  "telemetry-hub": "chart",
  "explain-draw-ai": "pdf",
  "my-own-database": "db",
};

const interests = [
  { icon: "⌘", label: "Clean code & good design" },
  { icon: "☁", label: "Cloud & distributed systems" },
  { icon: "◇", label: "Open source & AI" },
  { icon: "▱", label: "Linux & systems programming" },
  { icon: "△", label: "Hiking & nature" },
  { icon: "↗", label: "Learning by building" },
];
---

<Layout>
  <section class="hero">
    <div>
      <div class="kicker">Software engineer</div>
      <h1>Hi, I'm {name}, a <span>Software Engineer</span>.</h1>
      <p class="intro">
        I build backend systems with Java, Spring Boot and AWS: REST APIs,
        event-driven workflows and services that hold up in production.
      </p>
      <ul class="tags hero-tags" aria-label="Core technologies">
        {stack.map((tech) => <li class="tag">{tech}</li>)}
      </ul>
      <div class="actions">
        <a class="button" href="#projects">⌘ &nbsp; View my projects →</a>
        <a class="button secondary" href="#about">A little about me ↓</a>
      </div>
    </div>
    <div class="hero-art">
      <div class="art-card">
        <div class="float f1" aria-hidden="true">☁</div>
        <div class="float f2" aria-hidden="true">▣</div>
        <div class="float f3" aria-hidden="true">⌘</div>
        <div class="float f4" aria-hidden="true">⌁</div>
        <img src={base + "assets/me_bg_removed.png"} alt="Andres" />
      </div>
    </div>
  </section>

  <section class="projects" id="projects">
    <div class="section-top">
      <div>
        <div class="kicker">Featured projects</div>
        <h2>Things I build in my own time.</h2>
      </div>
      <a class="all" href={github}>View GitHub projects ↗</a>
    </div>
    <div class="project-grid">
      {
        projects.map((project) => (
          <article class="project">
            <div class={`thumb ${art[project.id] ?? ""}`}>
              {art[project.id] === "terminal" && (
                <div class="terminal">
                  <div>
                    <span class="prompt">{name.toLowerCase()}@dev</span>:~$ ccrun
                  </div>
                  <div>
                    <b>container started</b>
                  </div>
                  <div>namespace: pid,mount,uts</div>
                  <div>runtime: ready_</div>
                </div>
              )}
              {art[project.id] === "chart" && (
                <div class="chart">
                  <i class="bar" />
                  <i class="bar" />
                  <i class="bar" />
                  <i class="bar" />
                  <i class="bar" />
                </div>
              )}
              {art[project.id] === "pdf" && (
                <>
                  <div class="paper" />
                  <div class="clock" />
                </>
              )}
              {art[project.id] === "db" && (
                <svg viewBox="0 0 260 150" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="db-grad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#46c4ef" />
                      <stop offset="1" stop-color="#5367dc" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M70 42v56c0 7.7 21.5 14 48 14s48-6.3 48-14V42"
                    fill="#16295a"
                    stroke="#4777c9"
                    stroke-width="2"
                  />
                  <path
                    d="M70 70c0 7.7 21.5 14 48 14s48-6.3 48-14"
                    stroke="#4777c9"
                    stroke-width="2"
                  />
                  <ellipse cx="118" cy="42" rx="48" ry="14" fill="url(#db-grad)" />
                  <g fill="#249bd5">
                    <rect x="196" y="52" width="30" height="8" rx="2" />
                    <rect x="196" y="66" width="30" height="8" rx="2" opacity=".7" />
                    <rect x="196" y="80" width="30" height="8" rx="2" opacity=".45" />
                  </g>
                  <path
                    d="M166 60h18M166 74h18M166 88h18"
                    stroke="#4777c9"
                    stroke-width="2"
                  />
                </svg>
              )}
            </div>
            <div>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              {project.data.stack && (
                <ul class="tags">
                  {project.data.stack.map((tech) => (
                    <li class="tag">{tech}</li>
                  ))}
                </ul>
              )}
              <a class="project-link" href={base + "projects/" + project.id + "/"}>
                Explore project <span>↗</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="experience" id="experience">
    <div class="section-top">
      <div>
        <div class="kicker">Experience</div>
        <h2>Where I've worked.</h2>
      </div>
    </div>
    {
      experience.map((job) => (
        <article class="job">
          <div class="dates">
            {job.data.start} — {job.data.end}
          </div>
          <div>
            <h3>{job.data.title}</h3>
            <p class="company">
              {job.data.company}
              {job.data.location && (
                <span class="location">{job.data.location}</span>
              )}
            </p>
            <p class="job-description">{job.data.description}</p>
            {job.data.highlights && (
              <ul class="job-highlights">
                {job.data.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }
  </section>

  <section class="about" id="about">
    <div>
      <div class="kicker">About me</div>
      <h2>Curious developer.</h2>
      <p>
        I like understanding how things work, from low-level Linux concepts to
        cloud-native systems and AI tooling. Personal projects give me room to
        experiment, go deeper into unfamiliar technologies and build things just
        because they're interesting.
      </p>
    </div>
    <div class="interests" id="interests">
      {
        interests.map((interest) => (
          <div class="interest">
            <i aria-hidden="true">{interest.icon}</i> {interest.label}
          </div>
        ))
      }
    </div>
  </section>

  <section class="contact" id="contact">
    <div>
      <div class="kicker">Get in touch</div>
      <h3>Have an interesting idea?</h3>
      <p>
        Feel free to reach out to talk about projects, technology or potential
        collaborations.
      </p>
    </div>
    <a class="button" href={`mailto:${email}`}>✉ &nbsp; Contact me →</a>
  </section>
</Layout>
