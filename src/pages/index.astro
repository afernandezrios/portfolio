---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const name = "Andres";
const github = "https://github.com/afernandezrios";
const linkedin = "https://www.linkedin.com/in/afernandezrios/";
const base = import.meta.env.BASE_URL;

const experience = (await getCollection("experience")).sort((a, b) =>
  b.data.start.localeCompare(a.data.start),
);
const projects = (await getCollection("projects")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<Layout>
  <section class="hero">
    <h1>Hi, I'm {name}, a Backend Software Engineer.</h1>
    <p class="subtitle">
      I build backend systems with Java, Spring Boot and AWS: REST APIs,
      event-driven workflows, and services that hold up in production.
      Currently open to new opportunities.
    </p>
    <div class="social">
      <a href={github} aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path
            d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"
            fill="currentColor"
          />
        </svg>
      </a>
      <a href={linkedin} aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path
            d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.45-2.2 2.96V21H9z"
            fill="currentColor"
          />
        </svg>
      </a>
    </div>
  </section>

  <section id="experience">
    <h2 class="section-title">Experience</h2>
    {
      experience.map((job) => (
        <article class="job">
          <div class="dates">
            {job.data.start} — {job.data.end}
          </div>
          <div>
            <h3>{job.data.title}</h3>
            <p class="company">
              {job.data.company}
              {job.data.location && (
                <span class="location">{job.data.location}</span>
              )}
            </p>
            <p>{job.data.description}</p>
            {job.data.highlights && (
              <ul>
                {job.data.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }
  </section>

  <section id="projects">
    <h2 class="section-title">Projects</h2>
    <div class="project-grid">
      {
        projects.map((project) => (
          <article class="card">
            <a class="card-link" href={base + "projects/" + project.id + "/"}>
              {project.data.image && (
                <img
                  src={base + project.data.image.replace(/^\//, "")}
                  alt={project.data.title}
                />
              )}
              {project.data.video && (
                <video src={base + project.data.video.replace(/^\//, "")} autoplay loop muted playsinline />
              )}
              <h3>{project.data.title}</h3>
            </a>
            <p>{project.data.description}</p>
            <div class="links">
              {project.data.github && <a href={project.data.github}>GitHub</a>}
              {project.data.demo && <a href={project.data.demo}>Demo</a>}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
